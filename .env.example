# SuiPayroll Environment Configuration
# Copy to .env.local and fill in your values after deploying the contract

# ── Sui Network ──────────────────────────────────────────────
# Options: testnet | mainnet | devnet
VITE_SUI_NETWORK=testnet

# ── Deployed Contract (fill after `sui client publish`) ──────
# Package ID returned after publishing the Move contract
VITE_PACKAGE_ID=0xYOUR_PACKAGE_ID_HERE

# Module name (matches Move module declaration)
VITE_MODULE_NAME=suipayroll

# ── RPC Endpoint (optional override) ─────────────────────────
# Defaults to official Mysten Labs testnet RPC if not set
# VITE_SUI_RPC_URL=https://fullnode.testnet.sui.io:443
